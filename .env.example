# Default: host-only access. Change the password before exposing the service.
MV2A_BIND=127.0.0.1
MV2A_PORT=18620

# Optional: a private prepare file outside the default .prepare/ directory.
# MV2A_PREPARE_FILE=/private/path/marvis.json

# Optional: published image, available after the GitHub Actions release succeeds.
# MV2A_IMAGE=ghcr.io/qianjindexiaozu/marvis2api-panel-runtime:latest
